# Flask Configuration
FLASK_APP=run.py
FLASK_DEBUG=0
SECRET_KEY=change-this-in-production-key

# Database Configuration
# Render PostgreSQL (Automatically provided by Render when attaching a PostgreSQL database)
DATABASE_URL=

# Local MySQL Credentials (Optional for local dev)
DB_USER=root
DB_PASSWORD=your-local-db-password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=online_quiz_db

# Fallback to local SQLite file for offline development testing
USE_SQLITE_FALLBACK=True
